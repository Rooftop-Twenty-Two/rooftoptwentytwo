---
import Img from "./Img.astro";
// S1, Home hero (re-skin / Wolfgang direction).
// Near-black canvas, slow-pan (Ken Burns) office photo, kicker, big display
// two-line H1 (second line in the accent colour), dual pill CTAs. No video
// asset yet, structured so a <video> can drop in behind .whero__media later.
const poster = "/images/office/office-studio-01.jpg";

// Recent awards, shown bottom-right of the hero in white. Logos render
// automatically once the white SVGs are dropped at these paths; until then the
// text reference shows on its own.
import { existsSync } from "node:fs";
import path from "node:path";
const awardDefs = [
  { logo: "/images/spider-awards-rev.png", result: "Gold winners", name: "Spider Awards" },
  { logo: "/images/DMA-Generic-Pink-Blue-270x270-1-cutout.png", result: "Finalist", name: "Digital Media Awards", href: "/latest/digital-media-awards-seo-finalist/" },
  { logo: "/images/European-Search-Awards-Logo_full_colour-cutout.png", result: "Finalist", name: "European Search Awards", href: "/latest/european-search-awards-two-nominations/" },
];
const awards = awardDefs.map((a) => ({ ...a, hasLogo: existsSync(path.join(process.cwd(), "public", a.logo)) }));
---

<section class="whero">
  <div class="whero__media" aria-hidden="true">
    <picture>
      <!-- On phones the wide studio shot's big wall wordmark clashes with the
           headline, so swap to a calmer team shot below 880px. -->
      <source media="(max-width: 880px)" srcset="/images/office/office-collab-01.jpg" />
      <Img src={poster} alt="The Rooftop Twenty Two studio in Glasnevin, Dublin" fetchpriority="high" />
    </picture>
    <div class="whero__scrim"></div>
  </div>

  <div class="whero__inner">
    <p class="kicker kicker--on-dark kicker--script whero__kicker">Brand, web and marketing for growing businesses</p>
    <h1 class="whero__title">
      <span class="whero__lead">A clear plan for growth.</span>
      <span class="whero__lead whero__accent">Delivered by one team.</span>
    </h1>
    <p class="whero__sub">
      We help businesses decide where their marketing should focus, then
      deliver it. Brand, website and campaigns under one roof, measured
      against enquiries, sales and revenue.
    </p>
    <div class="whero__cta">
      <a href="/contact/" class="wbtn wbtn--accent">Talk to us about your growth plans</a>
      <a href="/work/" class="wbtn wbtn--ghost">See our results</a>
    </div>
  </div>

  <ul class="whero__awards" aria-label="Recent awards">
    {awards.map((a) => (
      <li class="whero__award">
        <a href={a.href}>
          {a.hasLogo && <Img class="whero__award-logo" src={a.logo} alt={a.name} loading="lazy" decoding="async" />}
          <span class="whero__award-txt"><b>{a.result}</b> <span aria-hidden="true">·</span> {a.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .whero {
    position: relative;
    min-height: clamp(620px, 92vh, 1000px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--c-dark);
    padding: var(--w-gutter);
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }
  .whero__media { position: absolute; inset: 0; z-index: 0; }
  .whero__media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(1.02);
    animation: whero-pan 24s ease-in-out infinite alternate;
  }
  .whero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(13,32,48,0.94) 0%, rgba(13,32,48,0.42) 45%, rgba(13,32,48,0.6) 100%);
  }
  /* On mobile the headline sits over the image, so darken the scrim across the
     whole frame (especially the top) to guarantee contrast on any photo. */
  @media (max-width: 880px) {
    .whero__scrim {
      background:
        linear-gradient(to top, rgba(13,32,48,0.96) 0%, rgba(13,32,48,0.74) 50%, rgba(13,32,48,0.82) 100%);
    }
  }
  @keyframes whero-pan {
    from { transform: scale(1.02) translate3d(0, 0, 0); }
    to   { transform: scale(1.1) translate3d(-1.5%, -1.5%, 0); }
  }

  .whero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--w-container);
    margin: 0 auto;
  }
  .whero__kicker { margin-bottom: 1.5rem; }

  .whero__title {
    font-family: var(--w-font-display);
    font-weight: 600;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    color: var(--c-on-dark);
    margin: 0;
  }
  .whero__lead { display: block; }

  .whero__accent { color: var(--c-accent-2-bright); }

  .whero__sub {
    font-family: var(--w-font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-on-dark-soft);
    max-width: 40ch;
    margin: 1.75rem 0 0;
  }
  .whero__cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.25rem; }

  /* Awards cluster — bottom-right of the hero, in white. */
  .whero__awards {
    position: absolute; z-index: 1;
    right: var(--w-gutter); bottom: clamp(3rem, 8vh, 6rem);
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.7rem;
    text-align: right;
  }
  .whero__award a {
    display: inline-flex; align-items: center; gap: 0.6rem;
    text-decoration: none; color: var(--c-on-dark);
    opacity: 0.82; transition: opacity var(--w-dur-fast) var(--w-ease);
  }
  .whero__award a:hover { opacity: 1; }
  .whero__award-logo { height: 30px; width: auto; filter: brightness(0) invert(1); }
  .whero__award-txt { font-family: var(--w-font-body); font-size: 0.8rem; letter-spacing: 0.02em; color: #fff; white-space: nowrap; }
  .whero__award-txt b { font-weight: 700; }
  .whero__award-txt span { color: var(--c-on-dark-soft); padding: 0 0.15rem; }
  /* On mobile the hero stacks and the awards sit in-flow below the content. */
  @media (max-width: 880px) {
    .whero { flex-direction: column; justify-content: flex-end; align-items: stretch; }
    .whero__awards {
      position: static; right: auto; bottom: auto; width: 100%;
      align-items: flex-start; text-align: left; flex-wrap: wrap;
      flex-direction: row; gap: 1rem 1.75rem;
      margin-top: 1.75rem; padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }
    .whero__award-logo { height: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .whero__media img { animation: none; transform: scale(1.02); }
  }
</style>
