---
import Img from "../Img.astro";
// S3, About / intro split. Kicker + H2 (with emphasised phrase) + body + CTAs
// on one side; image on the other. White section.
const image = "/images/office/office-portrait-01.jpg";
---

<section class="ai">
  <div class="ai__inner">
    <div class="ai__copy reveal">
      <p class="kicker kicker--script">The challenge</p>
      <h2 class="ai__title">
        Where most businesses <em>get stuck</em>.
      </h2>
      <ul class="ai__list">
        <li>Budget is going out, but it&rsquo;s hard to say what it returns.</li>
        <li>The brand and website haven&rsquo;t kept pace with the business.</li>
        <li>The marketing team is capable, but stretched across too many channels.</li>
      </ul>
      <div class="ai__cta">
        <a href="/about/" class="wbtn wbtn--primary">About us</a>
        <a href="/contact/" class="wbtn wbtn--ghost ai__ghost">Get in touch</a>
      </div>
    </div>
    <figure class="ai__media reveal">
      <Img src={image} alt="A Rooftop Twenty Two designer at work in the Dublin studio" loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<style>
  .ai { background: var(--c-bg); color: var(--c-ink); padding-block: var(--w-section-y); }
  .ai__inner {
    max-width: var(--w-container);
    margin: 0 auto;
    padding-inline: var(--w-gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 920px) {
    .ai__inner { grid-template-columns: 1.05fr 0.95fr; gap: 5rem; }
  }
  .ai__title {
    font-family: var(--w-font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    margin: 1rem 0 0;
  }
  .ai__title em { font-style: normal; color: var(--c-accent); }
  .ai__list {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    max-width: 46ch;
    border-top: 1px solid var(--c-line);
  }
  .ai__list li {
    font-family: var(--w-font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-soft);
    padding: 1rem 0 1rem 1.75rem;
    border-bottom: 1px solid var(--c-line);
    position: relative;
  }
  .ai__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(1rem + 0.7em);
    width: 0.75rem;
    height: 2px;
    background: var(--c-accent);
  }
  .ai__cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .ai__ghost { color: var(--c-ink); }
  .ai__media { margin: 0; border-radius: var(--w-radius); overflow: hidden; aspect-ratio: 4 / 3; }
  .ai__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
