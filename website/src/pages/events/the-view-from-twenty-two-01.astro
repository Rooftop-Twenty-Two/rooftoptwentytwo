---
import Layout from "../../layouts/Layout.astro";
import Picture from "../../components/Picture.astro";
import { existsSync } from "node:fs";
import path from "node:path";

// Unlisted page. It is deliberately not in the header, the menu overlay, the
// footer or /events/, it is noindex, and astro.config.mjs keeps it out of the
// sitemap. The only way in is the link we send people.

// Assets render only once present in the repo, so nothing shows broken. Until
// the real photos and logos land, each slot falls back to a lettered
// placeholder. Drop a file at the path below and it takes over on the next
// build, no code change needed.
const hasFile = (p: string) => existsSync(path.join(process.cwd(), "public", p));

const ev = {
  series: "The View from Twenty Two",
  // White wordmark, so it sits on the banner as-is and is inverted on the card.
  seriesLogo: "/images/events/the-view-from-twenty-two-logo.svg",
  episode: "Episode 01",
  headline: "Diarmuid McSweeney and Lorraine Heskin join Gary Fox",
  presentedBy: "Presented by Gary Fox",
  hostedBy: "Hosted by Rooftop Twenty Two",
  banner: "/images/events/episode-01-hero.jpg",
  date: "8 October",
  time: "11:00",
  venue: "Rooftop Twenty Two, Talent Garden Dublin",
  address: "Claremont Avenue, Glasnevin, Dublin 11, D11 YNR2",
  directions:
    "https://www.google.com/maps/search/?api=1&query=Talent+Garden+Dublin%2C+Claremont+Avenue%2C+Glasnevin%2C+Dublin+11%2C+D11+YNR2",
  format: "In person at Talent Garden Dublin.",
};

// One shape for host and guests so the three profiles render the same way.
// `focus` is the object-position for the square crop: portrait shots need the
// frame pulled up or the centre crop lands on the sitter's chest.
const host = {
  initials: "GF",
  name: "Gary Fox",
  role: "Presenter",
  photo: "/images/events/gary-fox.jpg",
  focus: "center center",
  bio: "Gary Fox hosts The Entrepreneur Experiment, Ireland&rsquo;s top-ranked independent business podcast, and has interviewed hundreds of entrepreneurs about the habits and decisions behind their success. Before podcasting, he founded the short-term rental management company HostButlers, taught brand strategy as a marketing lecturer at Dublin Business School, and worked in brand solutions at AdRoll before starting the video platform VideoScamp. Each episode of The View from Twenty Two, he sits down with a different founder to get into the real story behind their business and their brand.",
};

const guests = [
  {
    initials: "DM",
    name: "Diarmuid McSweeney",
    role: "Co-Founder, Gym+Coffee",
    photo: "/images/events/diarmuid-mcsweeney.jpg",
    focus: "center center",
    bio: "Diarmuid McSweeney co-founded Gym+Coffee in 2017 alongside Niall Horgan and Karl Swaine, and today serves as the company&rsquo;s Chief Marketing Officer and Chief Community Officer. The idea came out of the active, outdoor lifestyle the three picked up while travelling in Australia and California, and the brand has grown into one of Ireland&rsquo;s fastest-growing apparel labels, with stores in Dublin, Cork and Limerick and a growing customer base in the UK and US.",
  },
  {
    initials: "LH",
    name: "Lorraine Heskin",
    role: "Founder &amp; CEO, Gourmet Food Parlour",
    photo: "/images/events/lorraine-heskin.jpg",
    focus: "center 12%",
    bio: "Lorraine Heskin studied at the University of Limerick and spent several years working in the food industry in New York before founding Gourmet Food Parlour in 2006, opening a 25-seat caf&eacute; in D&uacute;n Laoghaire. Under her leadership, the group has grown into one of Dublin&rsquo;s best-known restaurant businesses, with 12 locations across Dublin, Meath and Galway, several concepts inside Arnotts, and a catering arm that works with organisations including the FAI, Shamrock Rovers and the Olympic Federation of Ireland. She was an EY Entrepreneur of the Year finalist in 2023 and was later named CEO of the Year at the Business Post Leadership and Excellence Awards.",
  },
];
---

<Layout
  title="The View from Twenty Two, Episode 01 | Rooftop Twenty Two"
  description="Gary Fox sits down with Diarmuid McSweeney of Gym+Coffee and Lorraine Heskin of Gourmet Food Parlour. 8 October, 11:00, at Rooftop Twenty Two, Talent Garden Dublin."
  hideStickyMobileCTA={true}
  noindex={true}
>
  <!-- Banner -->
  <section class="tv-banner">
    {ev.banner && hasFile(ev.banner) && (
      <div class="tv-banner__media"><Picture src={ev.banner} alt="The Rooftop Twenty Two branded wall at Talent Garden Dublin" loading="eager" decoding="async" /></div>
    )}
    <div class="tv-banner__scrim"></div>
    <div class="tv-banner__inner">
      <h1 class="tv-banner__title">
        <span class="tv-banner__ep">{ev.episode}</span>
        {ev.headline}
      </h1>

      <p class="tv-banner__by">{ev.presentedBy} &middot; {ev.hostedBy}</p>

      <!-- The when and where live in the reserve card, so the hero closes on
           the series mark rather than repeating them. -->
      <div class="tv-eyebrow">
        {hasFile(ev.seriesLogo)
          ? <img class="tv-eyebrow__logo" src={ev.seriesLogo} alt={ev.series} loading="eager" decoding="async" />
          : <p class="tv-eyebrow__wordmark">{ev.series}</p>}
      </div>
    </div>
  </section>

  <!-- Body (left) + sticky reserve card (right) -->
  <section class="tv-main">
    <div class="tv-main__inner">

      <div class="tv-content">
        <div class="tv-block reveal">
          <h2 class="tv-h2">What the show is</h2>
          <p class="tv-p">Rooftop Twenty Two is hosting The View from Twenty Two, a new event series run in collaboration with Gary Fox. Each episode brings a different entrepreneur or brand founder into the room to talk about how they actually built what they&rsquo;ve built.</p>
        </div>

        <div class="tv-block reveal">
          <h2 class="tv-h2">About this episode</h2>
          <p class="tv-p">Gary Fox sits down with Diarmuid McSweeney, co-founder of Gym+Coffee, and Lorraine Heskin, founder of Gourmet Food Parlour, for a conversation about the businesses they built and the brands that carry them. Expect the early decisions that shaped each company and the thinking behind the brand itself. The parts of building a business that rarely make it into a pitch deck.</p>
          <p class="tv-p">Gary built his name doing exactly this on The Entrepreneur Experiment, and Episode 01 follows the same approach. One on one, direct, and focused on how these two founders actually make decisions day to day.</p>
        </div>

        <div class="tv-block reveal">
          <h2 class="tv-h2">Your host</h2>
          <div class="tv-person">
            <div class="tv-person__photo" style={`--focus: ${host.focus}`}>
              {hasFile(host.photo)
                ? <Picture src={host.photo} alt={`${host.name}, ${host.role}`} loading="lazy" decoding="async" />
                : <span class="tv-person__ph" aria-hidden="true">{host.initials}</span>}
            </div>
            <div>
              <p class="tv-person__name">{host.name}</p>
              <p class="tv-person__role" set:html={host.role} />
              <p class="tv-p" set:html={host.bio} />
            </div>
          </div>
        </div>

        <div class="tv-block reveal">
          <h2 class="tv-h2">Your guests</h2>
          {guests.map((g) => (
            <div class="tv-person">
              <div class="tv-person__photo" style={`--focus: ${g.focus}`}>
                {hasFile(g.photo)
                  ? <Picture src={g.photo} alt={`${g.name}, ${g.role.replace("&amp;", "and")}`} loading="lazy" decoding="async" />
                  : <span class="tv-person__ph" aria-hidden="true">{g.initials}</span>}
              </div>
              <div>
                <p class="tv-person__name">{g.name}</p>
                <p class="tv-person__role" set:html={g.role} />
                <p class="tv-p" set:html={g.bio} />
              </div>
            </div>
          ))}
        </div>

        <div class="tv-block reveal">
          <h2 class="tv-h2">What to expect</h2>
          <p class="tv-p">There will be tea, coffee and snacks on arrival, with time to talk before Gary takes the stage and again once the conversation wraps.</p>
        </div>
      </div>

      <!-- Sticky reserve card -->
      <aside class="tv-rail">
        <div class="tv-card">
          {hasFile(ev.seriesLogo)
            ? <div class="tv-card__series"><img src={ev.seriesLogo} alt={ev.series} loading="lazy" decoding="async" /></div>
            : <p class="tv-card__wordmark">{ev.series}</p>}
          <p class="tv-card__ep">{ev.episode}</p>
          <a href="#reserve" class="wbtn wbtn--accent tv-card__cta">Reserve your seat</a>

          <dl class="tv-meta">
            <div class="tv-meta__row">
              <dt>Date and time</dt>
              <dd>{ev.date}, {ev.time}</dd>
            </div>
            <div class="tv-meta__row">
              <dt>Location</dt>
              <dd>
                {ev.venue}<br />{ev.address}<br />
                <a href={ev.directions} target="_blank" rel="noopener">Get directions</a>
              </dd>
            </div>
            <div class="tv-meta__row">
              <dt>Format</dt>
              <dd>{ev.format}</dd>
            </div>
          </dl>
        </div>
      </aside>

    </div>
  </section>

  <!-- Reserve -->
  <section class="tv-reserve" id="reserve">
    <div class="tv-reserve__inner">
      <div class="tv-reserve__head reveal">
        <p class="kicker kicker--on-dark kicker--script">Save your spot</p>
        <h2 class="tv-reserve__title">Reserve your seat.</h2>
        <p class="tv-reserve__lead">We&rsquo;re keeping the room small so it stays a proper conversation. Put your name down and we&rsquo;ll come back to confirm your seat and everything you need on the day. First come, first served. We&rsquo;ll let you know either way.</p>
      </div>

      <form class="tv-form reveal" action="https://eu-submit.jotform.com/submit/261524935328057" method="post" accept-charset="utf-8" data-event-form>
        <input type="hidden" name="formID" value="261524935328057" />
        <input type="hidden" name="simple_spc" value="261524935328057-261524935328057" />
        <div class="tv-form__row">
          <div class="tv-form__field">
            <label class="tv-form__label" for="tv-first">First name</label>
            <input id="tv-first" type="text" name="q2_q2_fullname0[first]" required autocomplete="given-name" />
          </div>
          <div class="tv-form__field">
            <label class="tv-form__label" for="tv-last">Last name</label>
            <input id="tv-last" type="text" name="q2_q2_fullname0[last]" required autocomplete="family-name" />
          </div>
        </div>
        <div class="tv-form__field">
          <label class="tv-form__label" for="tv-email">Email</label>
          <input id="tv-email" type="email" name="q3_q3_email1" required autocomplete="email" />
        </div>
        <div class="tv-form__field">
          <label class="tv-form__label" for="tv-company">Company <span class="tv-form__opt">(optional)</span></label>
          <input id="tv-company" type="text" name="q4_q4_textbox2" autocomplete="organization" />
        </div>
        <!-- JotForm honeypot: must stay empty -->
        <input type="text" name="website" class="tv-form__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="wbtn wbtn--accent tv-form__submit">Reserve your seat</button>
        <p class="tv-form__note">No spam. We&rsquo;ll only email you about this event.</p>
        <p class="tv-form__status" role="status" aria-live="polite" data-form-status hidden></p>
      </form>
    </div>
  </section>
</Layout>

<style>
  .tv-h2 { font-family: var(--w-font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.1; color: var(--c-ink); margin: 0 0 1rem; }
  .tv-p { font-family: var(--w-font-body); font-size: var(--fs-body); line-height: 1.7; color: var(--c-ink-soft); margin: 0 0 1.1rem; max-width: 64ch; }

  /* Banner */
  .tv-banner { position: relative; isolation: isolate; color: var(--c-on-dark); min-height: clamp(400px, 48vw, 580px); display: flex; align-items: flex-end; }
  .tv-banner__media { position: absolute; inset: 0; z-index: -2; }
  .tv-banner__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tv-banner__scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(13,32,48,0.45) 0%, rgba(13,32,48,0.72) 55%, rgba(13,32,48,0.94) 100%); }
  .tv-banner__inner { max-width: var(--w-container); width: 100%; margin: 0 auto; padding: clamp(3rem, 6vw, 5rem) var(--w-gutter) clamp(2.5rem, 5vw, 4rem); }

  /* Series mark closes the hero, under the credit line. */
  .tv-eyebrow { display: flex; justify-content: flex-start; margin-top: clamp(1.75rem, 3vw, 2.75rem); }
  .tv-eyebrow__logo { height: clamp(52px, 6vw, 84px); width: auto; max-width: 100%; object-fit: contain; }
  /* Stands in for the series logo until the artwork lands. */
  .tv-eyebrow__wordmark { font-family: var(--w-font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.02em; color: #fff; border: 1px solid rgba(255,255,255,0.35); border-radius: var(--radius-pill); padding: 0.45rem 1.1rem; margin: 0; }
  .tv-banner__by { font-family: var(--w-font-body); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-accent-2); margin: 1.1rem 0 0; }

  .tv-banner__title { font-family: var(--w-font-display); font-weight: 600; font-size: clamp(2rem, 3.2vw + 0.9rem, 3.4rem); line-height: 1.06; letter-spacing: var(--tracking-display); color: #fff; margin: 1.75rem 0 0; max-width: 22ch; }
  .tv-banner__ep { display: block; font-family: var(--w-font-script); font-weight: 400; font-size: clamp(2.4rem, 2.6vw + 1.6rem, 3.6rem); line-height: 0.95; letter-spacing: 0; color: var(--c-accent); transform: rotate(-2deg); transform-origin: left; margin-bottom: 0.85rem; }

  /* Main two-column */
  .tv-main { background: var(--c-bg); color: var(--c-ink); padding-block: var(--w-section-y); }
  .tv-main__inner { max-width: var(--w-container); margin: 0 auto; padding-inline: var(--w-gutter); display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 960px) { .tv-main__inner { grid-template-columns: 1fr 360px; gap: 4rem; align-items: start; } }
  .tv-block { margin-bottom: 3rem; }
  .tv-block:last-child { margin-bottom: 0; }

  /* Host and guests */
  .tv-person { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .tv-person + .tv-person { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--c-line); }
  @media (min-width: 560px) { .tv-person { grid-template-columns: 148px 1fr; gap: 1.75rem; align-items: start; } }
  .tv-person__photo { border-radius: var(--w-radius); overflow: hidden; aspect-ratio: 1; background: var(--c-bg-alt); max-width: 148px; display: grid; place-items: center; }
  .tv-person__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--focus, center center); display: block; }
  /* Lettered stand-in until the real headshot is dropped in. */
  .tv-person__ph { font-family: var(--w-font-display); font-weight: 600; font-size: 2.25rem; letter-spacing: 0.04em; color: var(--c-ink-soft); opacity: 0.5; }
  .tv-person__name { font-family: var(--w-font-display); font-weight: 600; font-size: 1.25rem; color: var(--c-ink); margin: 0; }
  .tv-person__role { font-family: var(--w-font-body); font-size: 0.95rem; color: var(--c-ink-soft); margin: 0.15rem 0 1rem; }

  /* Sticky reserve card */
  @media (min-width: 960px) { .tv-rail { position: sticky; top: 6rem; } }
  .tv-card { background: var(--c-bg); border: 1px solid var(--c-line); border-radius: var(--w-radius); box-shadow: var(--w-shadow-soft); padding: clamp(1.5rem, 2.5vw, 2rem); }
  .tv-card__series { margin: 0 0 1rem; }
  /* The wordmark ships white for the dark banner; flip it black for this card. */
  .tv-card__series img { height: 52px; width: auto; max-width: 100%; object-fit: contain; filter: brightness(0); opacity: 0.9; }
  .tv-card__wordmark { font-family: var(--w-font-display); font-weight: 600; font-size: 1.1rem; line-height: 1.25; color: var(--c-ink); margin: 0 0 0.35rem; }
  .tv-card__ep { font-family: var(--w-font-body); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-accent); margin: 0 0 1.5rem; }
  .tv-card__cta { width: 100%; justify-content: center; }
  .tv-meta { margin: 1.5rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--c-line); }
  .tv-meta__row { display: grid; gap: 0.2rem; padding: 0.7rem 0; }
  .tv-meta__row dt { font-family: var(--w-font-body); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-ink-soft); }
  .tv-meta__row dd { font-family: var(--w-font-body); font-size: 1rem; line-height: 1.5; color: var(--c-ink); margin: 0; }
  .tv-meta__row dd a { color: var(--c-accent); text-decoration: underline; text-underline-offset: 3px; }

  /* Reserve */
  .tv-reserve { background: var(--c-dark); color: var(--c-on-dark); padding-block: var(--w-section-y); }
  .tv-reserve__inner { max-width: 720px; margin: 0 auto; padding-inline: var(--w-gutter); }
  /* Capped below --fs-h2 so the heading holds one line at every width. */
  .tv-reserve__title { font-family: var(--w-font-display); font-weight: 600; font-size: min(var(--fs-h2), 9vw, 3.6rem); letter-spacing: var(--tracking-display); color: var(--c-on-dark); margin: 0.4rem 0 0; }
  .tv-reserve__lead { font-family: var(--w-font-body); font-size: var(--fs-body); line-height: 1.65; color: var(--c-on-dark-soft); margin: 1rem 0 2.5rem; }
  .tv-form { display: grid; gap: 1.25rem; }
  .tv-form__row { display: grid; gap: 1.25rem; }
  @media (min-width: 520px) { .tv-form__row { grid-template-columns: 1fr 1fr; } }
  .tv-form__field { display: grid; gap: 0.45rem; }
  .tv-form__label { font-family: var(--w-font-body); font-weight: 600; font-size: 0.85rem; color: var(--c-on-dark); }
  .tv-form__opt { font-weight: 400; color: var(--c-on-dark-soft); }
  .tv-form__field input {
    font-family: var(--w-font-body); font-size: 1rem; padding: 0.85rem 1rem;
    border-radius: 12px; border: 1px solid rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.04); color: #fff;
  }
  .tv-form__field input:focus { outline: 2px solid var(--c-accent-2); outline-offset: 1px; }
  .tv-form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .tv-form__submit { justify-self: start; margin-top: 0.25rem; }
  .tv-form__note { font-family: var(--w-font-body); font-size: var(--fs-small); color: var(--c-on-dark-soft); margin: 0; }
  .tv-form__status { font-family: var(--w-font-body); font-size: var(--fs-small); color: #ffb3ad; margin: 0; }
</style>

<script>
  // Same pattern as /events/: submit to JotForm in the background (no-cors +
  // keepalive, so the request still completes), then send the visitor to
  // /thank-you/. With JS off the form posts to JotForm normally.
  const form = document.querySelector<HTMLFormElement>("[data-event-form]");
  if (form) {
    const dest = "/thank-you/";
    form.addEventListener("submit", (e) => {
      // Honeypot: if a bot filled it, skip the real submit.
      const hp = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (hp && hp.value) { e.preventDefault(); window.location.href = dest; return; }
      // Let the browser run native required-field validation first.
      if (!form.checkValidity()) return;
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
      fetch(form.action, { method: "POST", body: new FormData(form), mode: "no-cors", keepalive: true })
        .catch(() => {})
        .finally(() => { window.location.href = dest; });
    });
  }
</script>
