---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import EventBand from "../components/reskin/EventBand.astro";
import AboutIntro from "../components/reskin/AboutIntro.astro";
import HowWeWork from "../components/reskin/HowWeWork.astro";
import LogoWall from "../components/reskin/LogoWall.astro";
import SelectedWork from "../components/reskin/SelectedWork.astro";
import ServicesOverview from "../components/reskin/ServicesOverview.astro";
import FeatureBand from "../components/reskin/FeatureBand.astro";
import TeamPreview from "../components/reskin/TeamPreview.astro";
import ClientTestimonials from "../components/reskin/ClientTestimonials.astro";
import LatestInsights from "../components/reskin/LatestInsights.astro";
import WCtaBand from "../components/reskin/WCtaBand.astro";
---

<Layout
  title="Brand, Web & Digital Marketing Agency Dublin | Rooftop Twenty Two"
  description="Rooftop Twenty Two helps growing businesses decide where their marketing should focus, then delivers it. Brand, website and campaigns from one in-house team in Dublin, measured against enquiries, sales and revenue."
>
  <HeroHome />
  <AboutIntro />
  <HowWeWork />
  <ServicesOverview />
  <LogoWall />
  <SelectedWork />
  <FeatureBand />
  <ClientTestimonials />
  <EventBand />
  <TeamPreview />
  <LatestInsights />
  <WCtaBand
    heading="Let's talk about where the business is headed."
    body="Tell us where you want to be in 12 months. We'll come back with a clear view on how to get there, and a time to talk it through."
  />
</Layout>
