---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/reskin/PageHero.astro";

// Where JotForm redirects after any successful form (contact enquiries and
// event reservations both land here), so the copy stays generic. Kept out of
// search (noindex) and free of the pre-footer / sticky CTAs so it reads as a
// clean confirmation.
---

<Layout
  title="Thank you | Rooftop Twenty Two"
  description="Thank you. We'll be in touch."
  noindex={true}
  hidePreFooterCTA={true}
  hideStickyMobileCTA={true}
>
  <PageHero
    kicker="Message sent"
    title="Thank you. We&rsquo;ll be <em>in touch</em>."
    bg="/images/office/office-studio-01.jpg"
    secondary={{ label: "Back to home", href: "/" }}
  />
</Layout>
