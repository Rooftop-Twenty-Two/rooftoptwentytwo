---
// Newsletter landing page. Linked from the email campaign, kept out of the
// main IA and out of search (noindex + sitemap filter). Shows the three lead
// case studies, then a HubSpot form for replies.
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/reskin/PageHero.astro";
import Picture from "../components/Picture.astro";

// The three case studies we lead with on /work/. Sorted by `order`, so this
// follows the site if the running order changes.
const featured = (await getCollection("portfolio", ({ data }) => !data.needs_review))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
  .slice(0, 3);

// One-line takeaway per project, taken straight from the case study itself.
// Only figures we can stand over. Where there's no number, we say it plainly.
const HIGHLIGHTS: Record<string, string> = {
  "the-irish-defence-forces":
    "A national recruitment campaign, from the creative concept to the video and the paid social rollout.",
  "the-1933-furniture-company":
    "Google Ads conversion rate up 10%. Social following and engagement up 4%.",
  "gourmet-food-parlour":
    "1,000+ Google Ads conversions in the first two months, at €1.28 a conversion.",
};
---

<Layout
  title="Three projects, three sets of results | Rooftop Twenty Two"
  description="The work behind our newsletter. Brand, video, and performance marketing for three Irish businesses, with the numbers behind each one."
  noindex={true}
  hideStickyMobileCTA={true}
>
  <PageHero
    kicker="Newsletter"
    title="Three projects. <em>Three sets of results</em>."
    intro="Thanks for opening the email. Here's the work behind it. Three Irish businesses, three very different briefs, and the numbers we can stand over."
    primary={{ label: "Tell us what you're working on", href: "#contact" }}
    secondary={{ label: "See all our work", href: "/work/" }}
  />

  <!-- The three case studies -->
  <section class="nl-work">
    <div class="nl-work__inner">
      <div class="reveal">
        <p class="kicker kicker--script">Case studies</p>
        <h2 class="nl-h2">Have a look at these three.</h2>
      </div>

      <ul class="nl-cards">
        {featured.map((p) => (
          <li class="nl-card reveal">
            <a class="nl-card__link" href={`/work/${p.data.slug}/`}>
              {p.data.heroImage && (
                <figure class="nl-card__img r22-media">
                  <Picture src={p.data.heroImage} alt={p.data.name} loading="lazy" decoding="async" />
                </figure>
              )}
              <div class="nl-card__body">
                <h3 class="nl-card__client">{p.data.name}</h3>
                <p class="nl-card__tag">{p.data.tagline}</p>
                {HIGHLIGHTS[p.data.slug] && (
                  <p class="nl-card__result">{HIGHLIGHTS[p.data.slug]}</p>
                )}
                {p.data.services.length > 0 && (
                  <ul class="nl-card__services">
                    {p.data.services.map((s) => <li class="nl-tag">{s}</li>)}
                  </ul>
                )}
                <span class="nl-card__cta r22-arrow">
                  Read the case study <span class="r22-arrow__i" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <p class="nl-note">
        There&rsquo;s plenty more where that came from. <a href="/work/">See all our work</a>.
      </p>
    </div>
  </section>

  <!-- Reply form -->
  <section class="nl-contact" id="contact">
    <div class="nl-contact__inner">
      <div class="nl-contact__copy">
        <p class="kicker kicker--script">Get in touch</p>
        <h2 class="nl-h2">Tell us what you&rsquo;re working on.</h2>
        <p class="nl-contact__lead">
          No hard sell. Tell us what you&rsquo;re launching, scaling, or fixing, and we&rsquo;ll come
          back with a straight answer and a time to talk it through.
        </p>
        <div class="nl-contact__details">
          <a href="mailto:hey@rooftoptwentytwo.ie">hey@rooftoptwentytwo.ie</a>
          <a href="tel:+35316991422">+353 1 699 1422</a>
          <address>Rooftop Twenty Two, Claremont Avenue,<br />Glasnevin, Dublin 11, D11 YNR2</address>
        </div>
      </div>

      <div class="nl-form">
        <!-- Shown only if HubSpot's script is blocked (ad blockers, script
             blockers) or JavaScript is off, so nobody hits a dead end. -->
        <p class="nl-form__fallback" id="hs-form-fallback" hidden>
          The form isn&rsquo;t loading. Email us at
          <a href="mailto:hey@rooftoptwentytwo.ie">hey@rooftoptwentytwo.ie</a> instead and
          we&rsquo;ll come straight back to you.
        </p>
        <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js" is:inline></script>
        <script is:inline>
          if (window.hbspt) {
            hbspt.forms.create({
              portalId: "20325418",
              formId: "e283d5a1-cf2a-4c28-852f-f1e81eab20f6",
              region: "na1"
            });
          } else {
            document.getElementById("hs-form-fallback").hidden = false;
          }
        </script>
        <noscript>
          <p class="nl-form__fallback">
            The form needs JavaScript. Email us at
            <a href="mailto:hey@rooftoptwentytwo.ie">hey@rooftoptwentytwo.ie</a> instead and
            we&rsquo;ll come straight back to you.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nl-h2 {
    font-family: var(--w-font-display); font-weight: 600; font-size: var(--fs-h2);
    line-height: var(--lh-heading); letter-spacing: var(--tracking-display);
    color: var(--c-ink); margin: 0.4rem 0 0;
  }
  .nl-h2 em { font-style: italic; color: var(--c-accent); }

  /* Case studies */
  .nl-work { background: var(--c-bg-alt); color: var(--c-ink); padding-block: var(--w-section-y); }
  .nl-work__inner { max-width: var(--w-container); margin: 0 auto; padding-inline: var(--w-gutter); }

  .nl-cards { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 900px) { .nl-cards { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }

  /* Flex column so the "Read the case study" link sits on the same baseline
     across all three cards, whatever length the taglines run to. */
  .nl-card { display: flex; }
  .nl-card__link { display: flex; flex-direction: column; text-decoration: none; color: inherit; width: 100%; }
  .nl-card__body { display: flex; flex-direction: column; flex: 1; }
  .nl-card__img {
    margin: 0; border: 1px solid var(--c-line); border-radius: var(--w-radius);
    overflow: hidden; aspect-ratio: 4 / 3; background: #fff; box-shadow: var(--w-shadow-soft);
  }
  .nl-card__img :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--w-dur) var(--w-ease);
  }
  .nl-card__link:hover .nl-card__img :global(img) { transform: scale(1.04); }

  .nl-card__body { margin-top: 1.25rem; }
  .nl-card__client {
    font-family: var(--w-font-display); font-weight: 600; font-size: var(--fs-h3);
    line-height: 1.1; margin: 0;
    transition: color var(--w-dur-fast) var(--w-ease);
  }
  .nl-card__link:hover .nl-card__client { color: var(--c-accent); }
  .nl-card__tag {
    font-family: var(--w-font-body); font-size: var(--fs-body); color: var(--c-ink-soft);
    line-height: 1.5; margin: 0.4rem 0 0;
  }
  .nl-card__result {
    font-family: var(--w-font-body); font-size: var(--fs-body); font-weight: 600;
    color: var(--c-ink); line-height: 1.5; margin: 0.9rem 0 0;
    padding-left: 0.9rem; border-left: 2px solid var(--c-accent);
  }
  .nl-card__services { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.1rem 0 0; padding: 0; }
  .nl-tag {
    font-family: var(--w-font-body); font-size: 0.75rem; font-weight: 600; color: var(--c-ink-soft);
    background: var(--c-bg); border: 1px solid var(--c-line); border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem; white-space: nowrap;
  }
  .nl-card__cta {
    font-family: var(--w-font-body); font-weight: 600;
    font-size: 0.9rem; color: var(--c-accent); margin-top: auto; padding-top: 1.1rem;
  }

  .nl-note { font-family: var(--w-font-body); font-size: var(--fs-body); color: var(--c-ink-soft); margin: 3rem 0 0; }
  .nl-note a { color: var(--c-accent); text-decoration: none; font-weight: 600; }

  /* Reply form */
  .nl-contact { background: var(--c-bg); color: var(--c-ink); padding-block: var(--w-section-y); }
  .nl-contact__inner {
    max-width: var(--w-container); margin: 0 auto; padding-inline: var(--w-gutter);
    display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start;
  }
  @media (min-width: 900px) { .nl-contact__inner { grid-template-columns: 1fr 1.1fr; gap: 4.5rem; } }

  .nl-contact__lead {
    font-family: var(--w-font-body); font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--c-ink-soft); margin: 1.25rem 0 0; max-width: 46ch;
  }
  .nl-contact__details { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 2rem; }
  .nl-contact__details a { color: var(--c-accent); text-decoration: none; font-weight: 600; }
  .nl-contact__details address {
    font-style: normal; font-family: var(--w-font-body); font-size: var(--fs-small);
    color: var(--c-ink-soft); line-height: 1.6; margin-top: 0.5rem;
  }

  .nl-form {
    background: var(--c-bg-alt); border: 1px solid var(--c-line);
    border-radius: var(--w-radius); padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .nl-form__fallback { font-family: var(--w-font-body); font-size: var(--fs-body); color: var(--c-ink-soft); margin: 0; }
  .nl-form__fallback a { color: var(--c-accent); font-weight: 600; }

  /* HubSpot injects its own markup, so these have to reach outside Astro's scoping. */
  .nl-form :global(.hs-form-field) { margin-bottom: 1.1rem; }
  .nl-form :global(.hs-form-field > label) {
    display: block; font-family: var(--w-font-body); font-size: var(--fs-small);
    font-weight: 600; color: var(--c-ink); margin-bottom: 0.4rem;
  }
  .nl-form :global(.hs-form-field input[type="text"]),
  .nl-form :global(.hs-form-field input[type="email"]),
  .nl-form :global(.hs-form-field input[type="tel"]),
  .nl-form :global(.hs-form-field input[type="number"]),
  .nl-form :global(.hs-form-field select),
  .nl-form :global(.hs-form-field textarea) {
    width: 100%; box-sizing: border-box;
    font-family: var(--w-font-body); font-size: 1rem; color: var(--c-ink);
    background: var(--c-bg); border: 1px solid var(--c-line); border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }
  .nl-form :global(.hs-form-field textarea) { min-height: 8rem; resize: vertical; }
  .nl-form :global(.hs-form-field input:focus),
  .nl-form :global(.hs-form-field select:focus),
  .nl-form :global(.hs-form-field textarea:focus) {
    outline: 2px solid var(--c-accent); outline-offset: 1px; border-color: transparent;
  }
  .nl-form :global(.hs-button) {
    font-family: var(--w-font-body); font-weight: 700; font-size: 1rem;
    background: var(--c-accent); color: var(--c-accent-ink);
    border: 0; border-radius: var(--radius-pill); padding: 0.85rem 1.75rem;
    cursor: pointer; transition: background var(--w-dur-fast) var(--w-ease), color var(--w-dur-fast) var(--w-ease);
  }
  .nl-form :global(.hs-button:hover) { background: var(--c-accent-2); color: var(--c-ink); }
  .nl-form :global(.hs-error-msg),
  .nl-form :global(.hs-error-msgs label) {
    font-family: var(--w-font-body); font-size: var(--fs-small); color: var(--c-accent);
  }
  .nl-form :global(.hs-form-booleancheckbox-display),
  .nl-form :global(.legal-consent-container) {
    font-family: var(--w-font-body); font-size: var(--fs-small); color: var(--c-ink-soft); line-height: 1.5;
  }
  .nl-form :global(.submitted-message) {
    font-family: var(--w-font-body); font-size: var(--fs-body); color: var(--c-ink);
  }
</style>
