---
import { getCollection } from "astro:content";
import WServiceTemplate from "../../components/templates/WServiceTemplate.astro";
import SocialShowcase from "../../components/reskin/SocialShowcase.astro";

export async function getStaticPaths() {
  const entries = await getCollection("services");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { data: entry.data },
  }));
}

const { data } = Astro.props;
---

<WServiceTemplate {...data}>
  {data.slug === "social-media-management" && <SocialShowcase slot="showcase" />}
</WServiceTemplate>
