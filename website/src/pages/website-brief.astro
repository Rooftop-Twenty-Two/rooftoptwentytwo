---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/reskin/PageHero.astro";
import BreadcrumbSchema from "../components/seo/BreadcrumbSchema.astro";

// New-website briefing form. Same approach as /contact and /events: the site's
// own markup and styling, posting straight to JotForm (EU) so responses land in
// the JotForm inbox.
//
// Field names, option values, required flags and the form ID below are taken
// VERBATIM from the live JotForm form "Website Discovery & Requirements Form"
// (ID 262212815673052) so a submission from this page matches one made on
// JotForm exactly. If the JotForm form changes, mirror the change here.
// See docs/website-brief-form-spec.md. The honeypot (`website`) must stay empty;
// formID + simple_spc are JotForm's required hidden fields.
const JOTFORM_ID = "262212815673052";
const jotformAction = `https://eu-submit.jotform.com/submit/${JOTFORM_ID}`;
const simpleSpc = `${JOTFORM_ID}-${JOTFORM_ID}`;

// Option sets — values copied verbatim from the JotForm source.
const projectType = [
  "Brand-new website",
  "Rebuild/redesign of current site",
  "Not sure yet",
];
const brandAssets = [
  "High-resolution logos",
  "High-res imagery",
  "Video",
  "Brand guidelines",
  "Tone-of-voice guidelines",
  "Social media profiles",
];
const websiteGoals = [
  "Generate leads",
  "Capture enquiries (enquiry forms)",
  "Take bookings / show a calendar",
  "Publish blog and news updates",
  "Update with new products, listings or services",
  "Offer a brochure download",
  "Sell online (ecommerce)",
];
const contentApproach = [
  "Happy for R22 to write all copy (we'll review and amend it)",
  "We'll supply some copy ourselves, R22 to write the rest",
  "We'll supply all copy ourselves",
  "Not sure yet",
];
const currentPlatform = [
  "WordPress",
  "Squarespace",
  "Wix",
  "Shopify",
  "Custom build",
  "Don't know",
  "Not applicable (no current site)",
];
const domainControl = [
  "We do, and we have access",
  "Our previous developer / agency",
  "Not sure",
];
const platformPreference = [
  "Keep our current platform",
  "Happy to move to whatever R22 recommends",
  "We have a specific platform in mind (please tell us)",
];
const integrations = [
  "Email marketing (Mailchimp, HubSpot, etc.)",
  "CRM",
  "Booking / scheduling system",
  "Payment gateway",
  "Analytics (GA4, etc.)",
];
const promotion = [
  "Search engines (SEO)",
  "Pay per click",
  "Email",
  "Social",
  "Paid social",
  "Offline (radio, TV, print)",
  "Events",
];
const pageCounts = ["1–5", "5–10", "10–20", "20–50", "50–100"];
const addedServices = [
  "Logo / brand identity",
  "Illustrations",
  "Photography",
  "Video production",
];
const functionality = [
  "About us page",
  "Enquiry forms",
  "Blog / news",
  "Image gallery",
  "Newsletter signup",
  "Document downloads",
  "Data capture",
  "Maps",
  "Product catalogue (non-ecommerce)",
  "Ecommerce",
  "Integration with a third-party booking system",
  "Live chat",
];
const ongoingHelp = [
  "Training to use the website",
  "Performance and monitoring",
  "Backups",
  "Ongoing marketing",
  "Ongoing development",
  "Service level agreement",
  "Compliance measures",
];
const accessibility = [
  "Yes (please tell us)",
  "No",
  "Not sure — we'd like R22's guidance",
];
const budgets = ["€7–10k", "€10–15k", "€15–20k", "€20k+", "Not sure yet"];
---

<Layout
  title="New Website Brief | Rooftop Twenty Two"
  description="Brief us on your new website. Tell us about your business, your goals and what you need, and we'll come back with a plan and a quote."
  hideStickyMobileCTA={true}
>
  <BreadcrumbSchema items={[{ name: "Home", url: "/" }, { name: "Website brief", url: "/website-brief/" }]} />

  <PageHero
    kicker="Website brief"
    title="Tell us about your <em>new website</em>."
    intro="Share a little about your business, brand, current site and technical needs so we can scope your new website properly. Fields marked required are the ones we really need. The rest just gives us a head start."
  />

  <section class="wb">
    <div class="wb__inner">
      <form class="wb__form" action={jotformAction} method="post" accept-charset="utf-8" data-brief-form>
        <input type="hidden" name="formID" value={JOTFORM_ID} />
        <input type="hidden" name="simple_spc" value={simpleSpc} />
        <!-- JotForm honeypot: must stay empty -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="wb__hp" />

        <!-- 1 — Your details -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">01</span> Your details</legend>
          <div class="wb__grid">
            <label class="wb__field">
              <span class="wb__label">First name <span class="wb__req">*</span></span>
              <input type="text" name="q3_q3_textbox1" required autocomplete="given-name" />
            </label>
            <label class="wb__field">
              <span class="wb__label">Last name <span class="wb__req">*</span></span>
              <input type="text" name="q4_q4_textbox2" required autocomplete="family-name" />
            </label>
            <label class="wb__field">
              <span class="wb__label">Phone number <span class="wb__req">*</span></span>
              <input type="tel" name="q5_q5_phone3[full]" required autocomplete="tel" />
            </label>
            <label class="wb__field">
              <span class="wb__label">Email address <span class="wb__req">*</span></span>
              <input type="email" name="q6_q6_email4" required autocomplete="email" placeholder="you@company.com" />
            </label>
            <label class="wb__field">
              <span class="wb__label">Company name <span class="wb__req">*</span></span>
              <input type="text" name="q7_q7_textbox5" required autocomplete="organization" />
            </label>
            <label class="wb__field">
              <span class="wb__label">Current website domain <span class="wb__opt">(optional)</span></span>
              <input type="text" name="q8_q8_textbox6" inputmode="url" placeholder="https://" />
            </label>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">Is this a brand-new website or a rebuild/redesign? <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--grid">
              {projectType.map((opt) => (
                <label class="wb__check">
                  <input type="radio" name="q9_q9_radio7" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>
        </fieldset>

        <!-- 2 — About your business -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">02</span> About your business</legend>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Business summary <span class="wb__req">*</span></span>
            <span class="wb__help">Who you are, what you do, and what makes you different.</span>
            <textarea name="q11_q11_textarea9" rows="4" required></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Market position <span class="wb__opt">(optional)</span></span>
            <span class="wb__help">Where you sit. Budget, mid-market, premium, and why.</span>
            <textarea name="q12_q12_textarea10" rows="3"></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Main competitors <span class="wb__opt">(optional)</span></span>
            <textarea name="q13_q13_textarea11" rows="3"></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Target audiences <span class="wb__req">*</span></span>
            <textarea name="q14_q14_textarea12" rows="3" required></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Commercial objectives <span class="wb__req">*</span></span>
            <span class="wb__help">What a successful website actually does for the business.</span>
            <textarea name="q15_q15_textarea13" rows="3" required></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">What does success look like in 12 months? <span class="wb__req">*</span></span>
            <span class="wb__help">Include the metrics or outcomes that matter.</span>
            <textarea name="q16_q16_textarea14" rows="3" required></textarea>
          </label>
        </fieldset>

        <!-- 3 — Brand and content -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">03</span> Brand and content</legend>

          <div class="wb__group">
            <p class="wb__group-label">What brand assets can you provide?</p>
            <p class="wb__help">Tick everything you already have. Don't worry about gaps, we can fill them.</p>
            <div class="wb__options wb__options--grid">
              {brandAssets.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q18_q18_checkbox16[]" value={opt} />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">What must the website do?</p>
            <div class="wb__options wb__options--grid">
              {websiteGoals.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q19_q19_checkbox17[]" value={opt} />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">R22 writing copy: what works best for you? <span class="wb__req">*</span></p>
            <p class="wb__help">Website copy is written by our team as part of the project, and you'll be able to review and amend it before launch.</p>
            <div class="wb__options wb__options--stack">
              {contentApproach.map((opt) => (
                <label class="wb__check">
                  <input type="radio" name="q20_q20_radio18" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>
        </fieldset>

        <!-- 4 — Your current website -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">04</span> Your current website</legend>
          <label class="wb__field wb__field--full">
            <span class="wb__label">What do you like about your current website? <span class="wb__opt">(optional)</span></span>
            <textarea name="q22_q22_textarea20" rows="3"></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">What frustrates you about your current website? <span class="wb__opt">(optional)</span></span>
            <textarea name="q23_q23_textarea21" rows="3"></textarea>
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Websites you like <span class="wb__opt">(optional)</span></span>
            <span class="wb__help">Paste a few links, and a line on what you like about each if you can.</span>
            <input type="text" name="q24_q24_textbox22" placeholder="https://" />
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">How would you like your website to feel? <span class="wb__opt">(optional)</span></span>
            <span class="wb__help">A few words describing the feel and tone.</span>
            <input type="text" name="q25_q25_textbox23" />
          </label>
          <label class="wb__field wb__field--full">
            <span class="wb__label">Websites or brands you don't like, and why <span class="wb__opt">(optional)</span></span>
            <textarea name="q26_q26_textarea24" rows="3"></textarea>
          </label>
        </fieldset>

        <!-- 5 — Technical and platform -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">05</span> Technical and platform</legend>

          <div class="wb__group">
            <p class="wb__group-label">What is your current website built on? <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--grid">
              {currentPlatform.map((opt) => (
                <label class="wb__check">
                  <input type="radio" name="q28_q28_radio26" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <label class="wb__field wb__field--full">
            <span class="wb__label">Where is the website currently hosted? <span class="wb__opt">(optional)</span></span>
            <input type="text" name="q29_q29_textbox27" />
          </label>

          <div class="wb__group">
            <p class="wb__group-label">Who controls the domain name and DNS? <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--stack">
              {domainControl.map((opt) => (
                <label class="wb__check">
                  <input type="radio" name="q30_q30_radio28" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">Platform preference <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--stack">
              {platformPreference.map((opt) => (
                <label class="wb__check">
                  <input type="radio" name="q31_q31_radio29" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">What tools does the new website need to connect to?</p>
            <div class="wb__options wb__options--grid">
              {integrations.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q32_q32_checkbox30[]" value={opt} />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
            <label class="wb__field wb__field--full wb__field--tight">
              <span class="wb__label">Other <span class="wb__opt">(optional)</span></span>
              <input type="text" name="q32_q32_checkbox30[other]" placeholder="Other tools to connect to" />
            </label>
          </div>
        </fieldset>

        <!-- 6 — Scope and services -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">06</span> Scope and services</legend>

          <div class="wb__group">
            <p class="wb__group-label">How will the new website be promoted? <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--grid">
              {promotion.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q34_q34_checkbox32[]" value={opt} data-promo />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
            <label class="wb__field wb__field--full wb__field--tight">
              <span class="wb__label">Other <span class="wb__opt">(optional)</span></span>
              <input type="text" name="q34_q34_checkbox32[other]" data-promo-other placeholder="Another way you'll promote it" />
            </label>
            <p class="wb__err" data-promo-err hidden>Please choose at least one option, or add one under “Other”.</p>
          </div>

          <label class="wb__field wb__field--full">
            <span class="wb__label">Other promotion details <span class="wb__opt">(optional)</span></span>
            <input type="text" name="q35_q35_textbox33" />
          </label>

          <div class="wb__group">
            <p class="wb__group-label">Roughly how many pages will the website have? <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--pills">
              {pageCounts.map((opt) => (
                <label class="wb__pill">
                  <input type="radio" name="q36_q36_radio34" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">What added services are needed?</p>
            <div class="wb__options wb__options--grid">
              {addedServices.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q37_q37_checkbox35[]" value={opt} />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">What website functionality is required?</p>
            <div class="wb__options wb__options--grid">
              {functionality.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q38_q38_checkbox36[]" value={opt} />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">What ongoing help would you like?</p>
            <div class="wb__options wb__options--grid">
              {ongoingHelp.map((opt) => (
                <label class="wb__check">
                  <input type="checkbox" name="q39_q39_checkbox37[]" value={opt} />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="wb__group">
            <p class="wb__group-label">Do you need accessibility or compliance guidance? <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--stack">
              {accessibility.map((opt) => (
                <label class="wb__check">
                  <input type="radio" name="q40_q40_radio38" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
            <label class="wb__field wb__field--full wb__field--tight">
              <span class="wb__label">Please tell us about any accessibility or compliance needs <span class="wb__opt">(optional)</span></span>
              <textarea name="q41_q41_textarea39" rows="2"></textarea>
            </label>
          </div>
        </fieldset>

        <!-- 7 — Commercials -->
        <fieldset class="wb__section">
          <legend class="wb__legend"><span class="wb__num">07</span> Commercials</legend>

          <div class="wb__group">
            <p class="wb__group-label">Budget <span class="wb__req">*</span></p>
            <div class="wb__options wb__options--pills">
              {budgets.map((opt) => (
                <label class="wb__pill">
                  <input type="radio" name="q43_q43_radio41" value={opt} required />
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <label class="wb__field">
            <span class="wb__label">Required delivery date <span class="wb__req">*</span></span>
            <input type="date" id="wb-deadline" required aria-label="Required delivery date" />
          </label>
          <!-- JotForm expects the date split into month/day/year; populated on submit. -->
          <input type="hidden" name="q44_q44_datetime42[month]" data-date-part="month" />
          <input type="hidden" name="q44_q44_datetime42[day]" data-date-part="day" />
          <input type="hidden" name="q44_q44_datetime42[year]" data-date-part="year" />

          <label class="wb__field wb__field--full">
            <span class="wb__label">Additional information <span class="wb__opt">(optional)</span></span>
            <textarea name="q45_q45_textarea43" rows="4"></textarea>
          </label>
        </fieldset>

        <div class="wb__submit-row">
          <button type="submit" class="wbtn wbtn--accent">Send us the brief</button>
          <p class="wb__note">We read every brief properly and come back with a thoughtful reply.</p>
        </div>
        <p class="wb__status" role="status" aria-live="polite" data-form-status hidden></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Progressive enhancement: submit the brief to JotForm in the background
  // (no-cors + keepalive so the request still completes), then send the visitor
  // to /thank-you/. Without JS the form posts to JotForm normally.
  const form = document.querySelector<HTMLFormElement>("[data-brief-form]");
  if (form) {
    const dest = "/thank-you/";

    // Keep JotForm's month/day/year date fields in sync with the native picker.
    const dateEl = form.querySelector<HTMLInputElement>("#wb-deadline");
    const setPart = (part: string, v: string) => {
      const el = form.querySelector<HTMLInputElement>(`[data-date-part="${part}"]`);
      if (el) el.value = v;
    };
    const syncDate = () => {
      if (dateEl && dateEl.value) {
        const [y, m, d] = dateEl.value.split("-");
        setPart("month", m); setPart("day", d); setPart("year", y);
      } else {
        setPart("month", ""); setPart("day", ""); setPart("year", "");
      }
    };
    dateEl?.addEventListener("change", syncDate);

    const promoErr = form.querySelector<HTMLElement>("[data-promo-err]");

    form.addEventListener("submit", (e) => {
      // Honeypot: if a bot filled it, skip the real submit.
      const hp = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (hp && hp.value) { e.preventDefault(); window.location.href = dest; return; }

      syncDate();

      // Promotion is required (at least one, or an "Other" value).
      const promoChecked = form.querySelectorAll('[data-promo]:checked').length;
      const promoOther = form.querySelector<HTMLInputElement>("[data-promo-other]");
      const promoOk = promoChecked > 0 || !!(promoOther && promoOther.value.trim());
      if (promoErr) promoErr.hidden = promoOk;
      if (!promoOk) {
        e.preventDefault();
        promoErr?.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      if (!form.checkValidity()) return; // let the browser flag native required fields
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
      fetch(form.action, { method: "POST", body: new FormData(form), mode: "no-cors", keepalive: true })
        .catch(() => {})
        .finally(() => { window.location.href = dest; });
    });
  }
</script>

<style>
  .wb { background: var(--c-bg); color: var(--c-ink); padding-block: var(--w-section-y); }
  .wb__inner { max-width: 820px; margin: 0 auto; padding-inline: var(--w-gutter); }

  .wb__form { display: flex; flex-direction: column; gap: 2.5rem; }
  .wb__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* Sections */
  .wb__section {
    border: 1px solid var(--c-line); border-radius: var(--w-radius);
    background: var(--c-bg); box-shadow: var(--w-shadow-soft);
    padding: clamp(1.5rem, 3vw, 2.25rem); margin: 0; min-inline-size: 0;
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .wb__legend {
    display: flex; align-items: baseline; gap: 0.75rem;
    font-family: var(--w-font-display); font-weight: 600; font-size: var(--fs-h3);
    color: var(--c-ink); padding: 0; line-height: 1.1;
  }
  .wb__num { font-family: var(--w-font-display); font-weight: 700; font-size: 0.9rem; color: var(--c-accent); }

  /* Text fields */
  .wb__grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 620px) { .wb__grid { grid-template-columns: 1fr 1fr; } }
  .wb__field { display: flex; flex-direction: column; gap: 0.45rem; }
  .wb__field--full { grid-column: 1 / -1; }
  .wb__field--tight { margin-top: 1rem; }
  .wb__label { font-family: var(--w-font-body); font-weight: 600; font-size: 0.9rem; color: var(--c-ink); }
  .wb__opt { font-weight: 400; color: var(--c-ink-soft); }
  .wb__req { color: var(--c-accent); font-weight: 700; }
  .wb__help { font-family: var(--w-font-body); font-size: 0.85rem; color: var(--c-ink-soft); line-height: 1.5; margin: -0.15rem 0 0.1rem; }
  .wb__field input, .wb__field textarea {
    width: 100%; font-family: var(--w-font-body); font-size: 1rem;
    padding: 0.85rem 1rem; border-radius: 12px;
    border: 1px solid var(--c-line); background: var(--c-bg-alt); color: var(--c-ink);
    resize: vertical;
  }
  .wb__field input::placeholder, .wb__field textarea::placeholder { color: var(--c-ink-soft); opacity: 0.7; }
  .wb__field input:focus-visible, .wb__field textarea:focus-visible {
    outline: 2px solid var(--c-accent); outline-offset: 2px; border-color: transparent;
  }

  /* Checkbox / radio groups */
  .wb__group { display: flex; flex-direction: column; gap: 0.85rem; }
